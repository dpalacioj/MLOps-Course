# =============================================================================
# Variables de entorno — Curso MLOps
# =============================================================================
#   cp .env.example .env
#
# NUNCA commitees .env. Esta en .gitignore y gitleaks lo verifica en cada commit.
# =============================================================================

# --- MLflow ---
# Puerto 5001 en TODO el curso. El 5000 lo ocupa AirPlay Receiver en macOS.
# Antes del rediseno el repo mezclaba 5000 y 5001 entre scripts, notebooks y
# este archivo, y en Windows el estudiante terminaba con el servidor en un
# puerto y la configuracion apuntando al otro.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Alternativa sin servidor (solo tracking, SIN model registry):
# MLFLOW_TRACKING_URI=file:./mlruns

# Backend con base de datos — necesario para tener Model Registry:
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Artifact store S3 / MinIO (S05-S06) ---
# El stack local usa MinIO, que habla el protocolo S3. Por eso el codigo NO
# cambia al migrar a AWS: solo cambian estas variables.
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# En AWS real, NO pongas las llaves aqui: usa el rol de la tarea (ECS/App
# Runner) o AWS Secrets Manager. Ver sesiones/s06-cloud-cicd/README.md

# --- Prefect ---
PREFECT_API_URL=http://127.0.0.1:4200/api
# PREFECT_API_KEY=

# --- API de inferencia ---
# `ninguno` levanta la API sin modelo: /health responde model_loaded=false.
# Sirve para probar el contenedor en CI sin depender del registry.
TAXI_MODELO_URI=models:/nyc-taxi-duration@champion
TAXI_API_PORT=8000

# --- Rutas ---
DATA_DIR=./data
REPORTS_DIR=./reports

# --- Python ---
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# --- Sesion 8 (LLMOps) ---
# Opcional. Solo hace falta en la ultima sesion.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:4000   # gateway LiteLLM
