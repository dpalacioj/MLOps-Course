# =============================================================================
# Variables de entorno — starter template
# =============================================================================
#   cp .env.example .env
#
# NUNCA commitees .env. Esta en .gitignore y gitleaks lo verifica en cada commit.
# Este archivo (.env.example) SI va al repositorio: documenta que variables hace
# falta configurar, con valores de ejemplo que no son secretos.
#
# Un secreto commiteado no se arregla borrandolo en el commit siguiente: queda en
# el historial de git para siempre. Se arregla rotando la credencial.
# =============================================================================

# --- MLflow ---
# Puerto 5001, no 5000: en macOS el 5000 lo ocupa AirPlay Receiver, y el sintoma
# es un servidor "levantado" que responde cosas raras.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Alternativa sin servidor (solo tracking, SIN model registry):
# MLFLOW_TRACKING_URI=file:./mlruns

# Alternativa con base de datos local — SI da registry, sin Docker:
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- API de inferencia ---
# `ninguno` levanta la API sin modelo: /health responde modelo_cargado=false y
# /predict devuelve 503. Sirve para probar el contenedor en CI sin registry.
MIPROYECTO_MODELO_URI=ninguno
# MIPROYECTO_MODELO_URI=models:/miproyecto-modelo@champion

# Origenes CORS permitidos, separados por coma. NUNCA "*" junto a credenciales:
# el navegador rechaza la respuesta, y si funcionara, cualquier sitio podria
# hacer requests autenticados a tu API.
MIPROYECTO_CORS=http://127.0.0.1:3000

# --- Fuente de datos ---
# TODO(estudiante) 25: apunta esto a tu fuente real.
MIPROYECTO_BASE_URL=https://example.invalid/datos

# --- Rutas ---
DATA_DIR=./data
REPORTS_DIR=./reports

# --- Python ---
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
