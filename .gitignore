# =============================================================================
# .gitignore — Curso MLOps
# =============================================================================
# Regla de oro: ignoramos ARTEFACTOS (lo que se puede regenerar), nunca
# CONFIGURACION (lo que define como se regenera).
#
# El .gitignore anterior ignoraba globalmente *.json, *.yaml, *.yml, *.txt,
# *.html, Dockerfile y docker-compose.yml. Eso excluia silenciosamente el
# metadata.json de los modelos y los DAG de Mage, y rompia dos modulos del
# curso. Si necesitas ignorar algo, hazlo con la ruta mas especifica posible.
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# --- Entornos virtuales ---
.venv/
venv/
ENV/
env/
.python-version.local

# --- Testing y cobertura ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.tox/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Secretos (NUNCA commitear) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/
.secrets/

# --- Datos (se descargan con `make data`, se verifican por hash) ---
data/raw/
data/processed/
data/interim/
data/external/
*.parquet
*.csv
*.feather
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet
!proyecto/starter-template/tests/fixtures/**

# --- Modelos y artefactos (se obtienen del registry: models:/<name>@champion)
models/
artifacts/
*.pkl
*.joblib
*.ubj
*.bin
!*.b
mlruns/
mlartifacts/
mlflow.db
*.db-journal
outputs/
reports/*.html
!reports/.gitkeep

# --- Prefect ---
.prefect/
prefect.db

# --- Evidently ---
evidently_workspace/
drift_report*.html

# --- IDE / OS ---
.vscode/
!.vscode/settings.example.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Agentes de codigo ---
.claude/

# --- Terraform (si se agrega IaC) ---
.terraform/
*.tfstate
*.tfstate.*

# =============================================================================
# EXCEPCIONES EXPLICITAS
# Estos archivos SI van al repo aunque coincidan con patrones de arriba.
# =============================================================================
!**/metadata.json          # procedencia y checksums de datasets y modelos
!**/dataset-metadata.json
!.pre-commit-config.yaml
!.github/**/*.yml
!.github/**/*.yaml
!docker-compose.yml
!Dockerfile
!**/Dockerfile
