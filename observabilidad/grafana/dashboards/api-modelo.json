{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Salud del SERVICIO de inferencia: latencia, throughput, errores y distribucion de predicciones. Este dashboard NO mide drift de datos ni calidad del modelo: eso se responde con los reportes de Evidently (sesion 7), que comparan distribuciones sobre lotes de datos. Son dos preguntas distintas y ninguna sustituye a la otra.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Version del modelo que esta respondiendo, leida de la info metric `taxi_modelo_info`. Es el panel que hay que mirar PRIMERO cuando la latencia o la distribucion cambian de golpe: casi siempre coincide con una promocion.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "noValue": "sin modelo"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name"
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "taxi_modelo_info",
          "instant": true,
          "legendFormat": "{{model_name}} v{{model_version}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Modelo cargado",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latencia p95 de inferencia en la ventana actual. Se vigila el p95 y no la media porque la media esconde la cola: con 1 de cada 20 requests a 2 segundos, la media puede seguir en 25 ms y aun asi tener usuarios con timeouts.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taxi_inferencia_duracion_segundos_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Latencia p95 (inferencia)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Predicciones por segundo. Se cuentan PREDICCIONES, no requests: un lote de 100 viajes es un request y cien predicciones, y para dimensionar capacidad lo que importa es el segundo numero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(taxi_predicciones_total[$__rate_interval]))",
          "legendFormat": "predicciones/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Throughput",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Proporcion de operaciones que terminaron en error. Aproximacion consciente: el numerador cuenta requests fallidos y el denominador incluye predicciones individuales, asi que en trafico de lotes el ratio queda subestimado. Para SLO formal hay que instrumentar requests HTTP; para detectar que algo empezo a fallar, esto alcanza.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(taxi_errores_total[$__rate_interval])) / clamp_min(sum(rate(taxi_errores_total[$__rate_interval])) + sum(rate(taxi_predicciones_total[$__rate_interval])), 0.0001)",
          "legendFormat": "tasa de error",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tasa de error",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentiles calculados con `histogram_quantile` sobre los buckets del histogram. Son APROXIMACIONES: la precision esta limitada por los bordes de los buckets definidos en `metricas.py`. Si el p95 se pega al valor de un bucket, el problema es la eleccion de buckets, no el modelo. Se separa por `model_version` para ver el efecto de una promocion.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, model_version) (rate(taxi_inferencia_duracion_segundos_bucket[$__rate_interval])))",
          "legendFormat": "p50 v{{model_version}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, model_version) (rate(taxi_inferencia_duracion_segundos_bucket[$__rate_interval])))",
          "legendFormat": "p95 v{{model_version}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Latencia de inferencia — p50 y p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Predicciones por segundo desglosadas por version del modelo. Durante un despliegue progresivo se ven las dos versiones conviviendo; si la vieja no baja a cero, queda una replica sin actualizar.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.4",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (model_version) (rate(taxi_predicciones_total[$__rate_interval]))",
          "legendFormat": "v{{model_version}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Throughput por version del modelo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Errores por segundo separados por tipo. El desglose es lo que hace accionable el panel: `validacion` subiendo significa que un cliente cambio su contrato (no es tu bug); `modelo_no_disponible` significa que el registry o el alias fallan; `inferencia` significa que el modelo recibe algo que no sabe procesar. Los tres pintan igual de rojo y se arreglan en tres sitios distintos.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
